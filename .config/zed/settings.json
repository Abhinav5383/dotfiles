{
    "auto_indent": "syntax_aware",
    "indent_guides": {
        "background_coloring": "disabled",
        "coloring": "fixed"
    },
    "ensure_final_newline_on_save": false,
    "remove_trailing_whitespace_on_save": false,
    "cli_default_open_behavior": "existing_window",
    "diff_view_style": "unified",
    "disable_ai": true,
    "sticky_scroll": {
        "enabled": false,
    },
    "edit_predictions": {
        "allow_data_collection": "no",
        "provider": "none",
    },
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "agent": {
        "default_model": {
            "provider": "copilot_chat",
            "model": "gemini-3.1-pro-preview",
            "enable_thinking": true,
            "effort": "high",
        },
        "sidebar_side": "right",
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },
    "git_panel": {
        "dock": "left",
    },
    "inlay_hints": {
        "enabled": false,
    },
    "show_edit_predictions": true,
    "base_keymap": "VSCode",
    "hard_tabs": false,
    "tab_size": 4,
    "theme": "Monospace dark",
    "icon_theme": "Material Icon Theme",
    "ui_font_family": "Space Grotesk",
    "ui_font_size": 18,
    "buffer_font_family": "Monaspace Neon NF",
    "buffer_font_size": 18.0,
    "buffer_line_height": {
        "custom": 1.4,
    },
    "buffer_font_features": {
        "calt": true,
        "ss01": true,
        "ss02": true,
        "ss03": true,
        "ss04": true,
        "ss05": true,
        "ss06": true,
        "ss07": true,
        "ss08": true,
        "ss09": true,
        "liga": true,
    },
    "terminal": {
        "font_size": 16.0,
        "font_family": "Monaspace Neon NF",
        "line_height": {
            "custom": 1.4,
        },
    },
    "telemetry": {
        "metrics": false,
        "diagnostics": false,
    },
    "toolbar": {
        "agent_review": false,
        "breadcrumbs": false,
        "quick_actions": false,
        "selections_menu": false,
    },
    "tab_bar": {
        "show_nav_history_buttons": false,
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
    },
    "minimap": {
        "show": "never",
    },
    "git": {
        "inline_blame": {
            "enabled": false,
        },
    },

    "use_on_type_format": false,
    "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true,
    },

    "format_on_save": "off",
    "languages": {
        "HTML": {
            "language_servers": [
                "vscode-html-language-server",
                "emmet-language-server",
                "biome",
            ],
            "formatter": { "language_server": { "name": "vscode-html-language-server" } },
        },
        "JavaScript": {
            "formatter": { "language_server": { "name": "biome" } },
            "language_servers": ["vtsls", "biome"],
        },
        "TypeScript": {
            "formatter": { "language_server": { "name": "biome" } },
            "language_servers": ["vtsls", "biome"],
        },
        "TSX": {
            "show_edit_predictions": true,
            "formatter": { "language_server": { "name": "biome" } },
            "language_servers": [
                "vtsls",
                "tailwindcss-language-server",
                "emmet-language-server",
                "biome",
            ],
        },
        "CSS": {
            "formatter": { "language_server": { "name": "biome" } },
            "language_servers": [
                "vscode-css-language-server",
                "tailwindcss-language-server",
                "emmet-language-server",
                "biome",
            ],
        },
        "JSON": {
            "formatter": { "language_server": { "name": "biome" } },
            "language_servers": ["json-language-server", "biome"],
        },
        "SCSS": {
            "formatter": "none",
            "language_servers": ["biome", "scss-lsp"],
        },
    },

    "lsp": {
        "biome": {
            "binary": {
                "path": "/usr/bin/biome",
                "arguments": ["lsp-proxy"],
            },
        }
    },
}
