{
    "json.schemaDownload.trustedDomains": {
        "https://schemastore.azurewebsites.net/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://www.schemastore.org/": true,
        "https://json.schemastore.org/": true,
        "https://json-schema.org/": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://biomejs.dev": true
    },

    // indentation
    "editor.indentSize": 4,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

    // fonts and themes
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "editor.inlineSuggest.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontLigatures": "'calt'",
    "terminal.integrated.fontLigatures.enabled": true,
    "terminal.integrated.fontSize": 16,
    "editor.fontSize": 15,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorTheme": "Monospace Dark",

    // ui
    "editor.minimap.enabled": false,
    "workbench.activityBar.location": "top",
    "editor.stickyScroll.enabled": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "editor.cursorSmoothCaretAnimation": "on",
    "window.customMenuBarAltFocus": false,

    // behaviour defaults
    "extensions.autoUpdate": "off",
    "workbench.editor.languageDetection": false,
    "editor.defaultFormatter": "biomejs.biome",
    "notebook.defaultFormatter": "biomejs.biome",

    // lsps
    // "editor.codeActionsOnSave": {
    //     "source.organizeImports": "always",
    //     "source.removeUnusedImports": "always"
    // },
    "biome.lsp.bin": "/usr/bin/biome",

    "[html]": {
        "editor.suggest.insertMode": "replace",
        "editor.defaultFormatter": "vscode.html-language-features"
    },

    "[json][jsonc][css][tailwindcss][javascript][javascriptreact][typescript][typescriptreact]": {
        "editor.defaultFormatter": "biomejs.biome"
    },

    "[json][jsonc]": {
        "editor.suggest.insertMode": "replace",
        "editor.defaultFormatter": "biomejs.biome",
        "editor.quickSuggestions": {
            "strings": true
        }
    },

    "breadcrumbs.enabled": false,
    "terminal.integrated.initialHint": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "explorer.confirmPasteNative": false,
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "editor.acceptSuggestionOnCommitCharacter": false,
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "diffEditor.renderSideBySide": true,
    "workbench.tree.stickyScrollMaxItemCount": 5
}
